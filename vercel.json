{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://lockethh-backend.onrender.com/api/:path*"
    },
    {
      "source": "/locket.conf",
      "destination": "https://lockethh-backend.onrender.com/locket.conf"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
