# Leave empty during local development: Vite forwards /api to localhost:5000.
# Vercel uses the first-party /api rewrite in vercel.json, even if an old
# cross-site VITE_API_URL is configured. Keep this empty for that deployment.
# On other hosts, configure a same-origin /api proxy where possible, or set
# VITE_API_URL=https://your-backend.example.com for a direct connection.
VITE_API_URL=
# Optional public URL to the generated Shadowrocket config.
# VITE_CONFIG_URL=https://your-domain.example/locket.conf
